# Modèle de configuration locale pour apps/web-host.
# Copier ce fichier en .env.local (jamais commité) puis remplir les valeurs :
#   cp apps/web-host/.env.example apps/web-host/.env.local
# Les variables NEXT_PUBLIC_* sont envoyées au navigateur : n'y mettre que des
# valeurs publiques. Ne jamais préfixer une clé secrète par NEXT_PUBLIC_.
# Next.js ne lit ce fichier qu'au démarrage : relancer `npm run web-host` après
# toute modification.

# --- Supabase (Project Settings → Data API / API Keys) ----------------------
# URL du projet, ex. https://abcdefghijklmnop.supabase.co (sans / final)
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon (publique, protégée par les règles RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SECRÈTE, contourne les RLS, côté serveur uniquement.
# Utilisée par les routes api/player-account/* et api/player-auth/*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Spotify (Developer Dashboard → ton app → Settings) ---------------------
# Client ID uniquement : flow PKCE, pas de Client Secret.
SPOTIFY_CLIENT_ID=
# Ces deux URI doivent aussi être déclarées dans les Redirect URIs de l'app
# Spotify. En local, 127.0.0.1 obligatoire (pas localhost).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_PLAYER_REDIRECT_URI=http://127.0.0.1:3000/api/player-auth/callback

# --- Comptes joueurs --------------------------------------------------------
# Secret HMAC qui signe les cookies de session joueur. Chaîne aléatoire longue,
# générée avec : openssl rand -hex 32
# Peut différer de la valeur de prod (sessions locales et prod simplement
# séparées). La changer déconnecte les joueurs, sans perte de données.
PLAYER_SESSION_SECRET=
